{
  "name": "rocket-launch-live-client",
  "version": "2.0.0",
  "description": "A Node.JS client for interacting with the RocketLaunch.Live API",
  "type": "module",
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "scripts": {
    "clear": "rm -rf ./lib",
    "build": "npm run clear && npm run build:esm",
    "build:esm": "tsc -p ./configs/tsconfig.esm.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p ./configs/tsconfig.testing.json",
    "test": "vitest",
    "verify:package": "./scripts/verify-package.sh",
    "reset": "rm -rf lib rocket-launch-live-client-*.tgz && npm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mendahu/rocket-launch-live-client.git"
  },
  "keywords": [
    "rocket",
    "rockets",
    "launch",
    "launches"
  ],
  "author": "Jake Robins",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mendahu/rocket-launch-live-client/issues"
  },
  "homepage": "https://github.com/mendahu/rocket-launch-live-client#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.1",
    "@types/sinon": "^22.0.0",
    "nock": "^14.0.16",
    "publint": "^0.3.21",
    "sinon": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  }
}
